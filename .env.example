# Copy to .env.dev or .env.prod and fill out

# Telegram tokens (do NOT commit real tokens)
TELEGRAM_TOKEN_CLIENT=your_client_bot_token_here
TELEGRAM_TOKEN_ADMIN=your_admin_bot_token_here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/bulletin

# Webhook vs Long Polling
USE_WEBHOOK=false
WEBHOOK_HOST=https://example.com
WEBHOOK_PATH=/webhook

# Environment
ENV=development
